# Build-only OCI artifacts shared by Builder and the node runtime image.
# Native binaries target the Ubuntu 22.04 ABI; no compiler enters the output.
ARG GOPROXY=https://proxy.golang.org,direct

FROM ubuntu:22.04 AS overlaybd-build

ARG OVERLAYBD_REV
COPY build/oci/build-overlaybd.sh build/oci/cache-import.h build/sandboxtemplate-builder/overlaybd-import-raw.cpp /build-tools/
RUN sh /build-tools/build-overlaybd.sh /out

# Optional integration test target; the normal tool bundle does not include it.
FROM overlaybd-build AS cache-import-test
COPY build/oci/cache-import-test.cpp /src/overlaybd/src/ublk/cache-import-test.cpp
RUN printf '\nadd_executable(cache-import-test cache-import-test.cpp)\ntarget_compile_options(cache-import-test PRIVATE -UNDEBUG)\ntarget_link_libraries(cache-import-test ublk_frontend_lib photon_static overlaybd_image_lib libublksrv_static ${CURL_LIBRARIES} ${OPENSSL_SSL_LIBRARY} ${OPENSSL_CRYPTO_LIBRARY} ${AIO_LIBRARIES})\n' >> /src/overlaybd/src/ublk/CMakeLists.txt \
    && cmake -S /src/overlaybd -B /src/overlaybd/build -DFETCHCONTENT_UPDATES_DISCONNECTED=ON \
    && cmake --build /src/overlaybd/build --target cache-import-test --parallel 8
ENV LD_LIBRARY_PATH=/out/lib
ENTRYPOINT ["/src/overlaybd/build/output/cache-import-test"]

FROM golang:1.26.3 AS convertor-build
ARG CONVERTOR_REV=a00e366f9bfc970ec4aaa00887541c4c1d9f9dab
ARG GOPROXY
ENV GOPROXY=${GOPROXY}
RUN git init /src/convertor \
    && cd /src/convertor \
    && git remote add origin https://github.com/containerd/accelerated-container-image.git \
    && for attempt in 1 2 3; do \
         git -c http.version=HTTP/1.1 fetch --depth 1 origin "$CONVERTOR_REV" && break; \
         [ "$attempt" -eq 3 ] && exit 1; \
         sleep $((attempt * 2)); \
       done \
    && git checkout --detach FETCH_HEAD \
    && CGO_ENABLED=0 go build -o /out/convertor ./cmd/convertor

FROM --platform=$BUILDPLATFORM golang:1.25 AS fsb-build
ARG TARGETOS=linux
ARG TARGETARCH=amd64
ARG GOPROXY
ENV GOPROXY=${GOPROXY}
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY api ./api
COPY cmd ./cmd
COPY internal ./internal
COPY pkg ./pkg
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -o /out/fsb-vm ./cmd/fsb-vm

FROM overlaybd-build AS oci-tools
COPY --from=fsb-build /out/fsb-vm /fsb-vm
COPY build/oci/package-tools.sh /package-tools.sh
RUN sh /package-tools.sh /out /fsb-vm /bundle

# The complete build toolchain and the smaller node bundle share these builds.
FROM scratch
COPY --from=overlaybd-build /out/ /opt/overlaybd/
COPY --from=convertor-build /out/convertor /usr/local/bin/convertor
COPY --from=fsb-build /out/fsb-vm /usr/local/bin/fsb-vm
COPY --from=oci-tools /bundle /bundle
