# Fastlet uses node-installed fsb-vm/OverlayBD tools and a node ublkd socket.
FROM --platform=$BUILDPLATFORM golang:1.25 AS fastlet-build
ARG TARGETOS
ARG TARGETARCH
ARG GOPROXY=https://proxy.golang.org,direct
ENV GOPROXY=${GOPROXY}
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY api ./api
COPY cmd ./cmd
COPY internal ./internal
COPY pkg ./pkg
ARG DEBUG=0
RUN case "$DEBUG" in 0) set -- ;; 1) set -- '-gcflags=all=-N -l' ;; *) exit 2 ;; esac \
    && mkdir -p /out \
    && for binary in fastlet sandbox-init vmm-capdrop; do \
         CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build "$@" -o "/out/$binary" "./cmd/$binary" || exit $?; \
       done

FROM ubuntu:22.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ca-certificates coreutils e2fsprogs iproute2 iptables mount tcpdump util-linux \
    libaio1 libcurl4 libssl3 libzstd1 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=fastlet-build /out/fastlet /workspace/fastlet
COPY --from=fastlet-build /out/sandbox-init /opt/fast-sandbox/bin/sandbox-init
# The Firecracker VMM capability-drop exec helper (FSEP-0003). The file
# basename is contractual: the jailer derives the jail root from the
# exec-file basename, so the helper must be installed as .../vmm-capdrop/firecracker
# to keep the jail layout and every Fastlet path consumer unchanged.
COPY --from=fastlet-build /out/vmm-capdrop /usr/local/libexec/fast-sandbox/vmm-capdrop/firecracker
ENV PATH=/opt/fast-sandbox/oci/current/bin:${PATH}
ENV FASTLET_CONTROL_PORT=":5758"
ENV FAST_SANDBOX_RUNTIME="container"
ENV RUNTIME_SOCKET="/run/containerd/containerd.sock"
WORKDIR /workspace
EXPOSE 5758
ENTRYPOINT ["/workspace/fastlet"]
