# sandboxtemplate-builder — golden-image build pipeline (SandboxTemplate).
#
# Contains the platform toolchain (oci2rootfs, firecracker, e2fsprogs,
# fsb-vm, OverlayBD tools, aws CLI) plus the embedded guest kernel.
# Native output uses oci2rootfs → snapshot → object-store publication;
# OverlayBD output uses fsb-vm build → OCI publication. The snapshot stage
# entry is the same binary under a symlinked name. OCI tools are copied from
# the shared artifact image, also consumed by firecracker-runtime.

ARG OCI_TOOLS_IMAGE=fast-sandbox/oci-tools:dev
ARG OCI2ROOTFS_REV=76d3f4648a591066a4419f972e4118f2d1d68a35
ARG FIRECRACKER_VERSION=v1.16.1

# --- shared OCI artifacts ------------------------------------------------
FROM ${OCI_TOOLS_IMAGE} AS oci-tools

# --- oci2rootfs (OCI layers → ext4) ---------------------------------------
FROM rust:1.88-bookworm AS oci2rootfs-build

ARG OCI2ROOTFS_REV

RUN git clone https://github.com/arcboxlabs/oci2rootfs.git /src/oci2rootfs \
    && cd /src/oci2rootfs \
    && git checkout --detach "$OCI2ROOTFS_REV" \
    && cargo build --release --locked -p oci2rootfs-cli

# --- sandboxtemplate-builder binary ----------------------------------------
FROM golang:1.25 AS builder-build

# GOPROXY is overridable (docker build --build-arg GOPROXY=...) so hosts
# without direct proxy.golang.org access can download modules from a mirror;
# the default keeps the Go toolchain behaviour unchanged.
ARG GOPROXY=https://proxy.golang.org,direct
ENV GOPROXY=${GOPROXY}

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
# internal/artifacts: the artifact-set conventions shared with the live
# snapshot producer (checksums, manifest encoding, index layout).
COPY api ./api
COPY internal/artifacts ./internal/artifacts
COPY internal/guestnetwork ./internal/guestnetwork
COPY internal/ocitemplate ./internal/ocitemplate
# internal/registryconfig: the compiled registry.json shape shared with the
# fastlet, consumed by registryauth.go to authenticate private pulls.
COPY internal/registryconfig ./internal/registryconfig
COPY cmd/sandboxtemplate-builder ./cmd/sandboxtemplate-builder
RUN CGO_ENABLED=0 go build -o /out/sandboxtemplate-builder ./cmd/sandboxtemplate-builder

# --- runtime image ---------------------------------------------------------
FROM ubuntu:22.04

ARG FIRECRACKER_VERSION
ARG OCI2ROOTFS_REV
# The default pins the Firecracker CI Amazon microvm kernel (6.18, ACPI +
# VMGenID) under its real name; override both together to embed a
# different kernel. NOTE: the historical "quickstart" vmlinux.bin is
# Linux 4.14.174 — too old to run modern execd sanely after a snapshot
# restore: it lacks random.trust_cpu support AND VMGenID, so the CRNG
# initialized during the bake boot is left without a reseed source on every
# resume and getrandom() blocks forever (execd POST /command, OpenSandbox
# #1695). Refresh the pinned artifact via:
#   curl -sS "https://s3.amazonaws.com/spec.ccfc.min?list-type=2&prefix=firecracker-ci/x86_64&max-keys=2000" | grep -o "<Key>[^<]*vmlinux[^<]*</Key>"
# and pick the newest x86_64/vmlinux-6.18.<x> (or 6.1.17x) key.
ARG KERNEL_NAME=vmlinux.bin
ARG KERNEL_URL=https://s3.amazonaws.com/spec.ccfc.min/firecracker-ci/20260729-c69d0c0490e6-0/x86_64/vmlinux-6.18.36

ENV OCI2ROOTFS_REV=${OCI2ROOTFS_REV}

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        busybox-static ca-certificates coreutils curl e2fsprogs iproute2 jq libaio1 \
        libzstd1 libcurl4 libgflags2.2 libglib2.0-0 libnl-3-200 libnl-genl-3-200 libssl3 mount procps tar unzip util-linux \
    && rm -rf /var/lib/apt/lists/*

# awscli v2: the ubuntu package is v1 whose botocore ignores the
# AWS_ENDPOINT_URL env var (S3-compatible targets would silently fall back
# to real AWS S3 with the tenant's credentials).
RUN set -eux; \
    curl -fsSL --retry 5 https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip -o /tmp/awscliv2.zip; \
    unzip -q /tmp/awscliv2.zip -d /tmp; \
    /tmp/aws/install; \
    rm -rf /tmp/aws /tmp/awscliv2.zip

# Firecracker release binary.
RUN set -eux; \
    archive="firecracker-${FIRECRACKER_VERSION}-x86_64.tgz"; \
    curl -fsSL --retry 5 "https://github.com/firecracker-microvm/firecracker/releases/download/${FIRECRACKER_VERSION}/${archive}" -o "/tmp/${archive}"; \
    tar -xzf "/tmp/${archive}" -C /tmp; \
    install -m 0755 "/tmp/release-${FIRECRACKER_VERSION}-x86_64/firecracker-${FIRECRACKER_VERSION}-x86_64" /usr/local/bin/firecracker; \
    rm -rf "/tmp/${archive}" "/tmp/release-${FIRECRACKER_VERSION}-x86_64"

COPY --from=oci2rootfs-build /src/oci2rootfs/target/release/oci2rootfs /usr/local/bin/oci2rootfs
COPY --from=oci-tools /opt/overlaybd/ /opt/overlaybd/
COPY --from=oci-tools /usr/local/bin/convertor /usr/local/bin/convertor
COPY --from=oci-tools /usr/local/bin/fsb-vm /usr/local/bin/fsb-vm
COPY --from=builder-build /out/sandboxtemplate-builder /usr/local/bin/sandboxtemplate-builder
COPY build/oci/overlaybd.json /etc/overlaybd/ublkd.json
COPY build/oci/entrypoint.sh /usr/local/bin/oci-entrypoint
RUN sed 's/"enable": true, "uriPrefix"/"enable": false, "uriPrefix"/' /etc/overlaybd/ublkd.json > /etc/overlaybd/overlaybd.json \
    && chmod 0755 /usr/local/bin/oci-entrypoint \
    && ln -s /opt/overlaybd/bin/overlaybd-import-raw /usr/local/bin/overlaybd-import-raw
ENV LD_LIBRARY_PATH=/opt/overlaybd/lib
ENV PATH=/opt/overlaybd/bin:${PATH}
ENV FAST_SANDBOX_OCI_ENABLED=auto

# Guest kernel, embedded in the builder image so builds do not download a
# kernel at build time. Override KERNEL_URL to pin a specific build.
RUN mkdir -p /usr/local/share/firecracker \
    && curl -fsSL --retry 5 "${KERNEL_URL}" -o "/usr/local/share/firecracker/${KERNEL_NAME}" \
    && chmod 0644 "/usr/local/share/firecracker/${KERNEL_NAME}" \
    && ln -s /usr/local/bin/sandboxtemplate-builder /usr/local/bin/sandbox-snapshot-stage

WORKDIR /build
ENTRYPOINT ["/usr/local/bin/oci-entrypoint", "/usr/local/bin/sandboxtemplate-builder"]
